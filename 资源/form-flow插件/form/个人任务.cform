{
  "id": "ceb2e490-d8d8-407f-8917-afd081e0c238",
  "fields": [
    {
      "id": "personal-task-name",
      "label": "任务",
      "type": "text",
      "required": true,
      "defaultValue": [],
      "enableDescription": true,
      "description": "要做什么？一句话说清楚（会作为文件名的一部分）"
    },
    {
      "id": "personal-task-project",
      "label": "项目",
      "type": "property_value_suggestion",
      "propertyName": "项目",
      "required": true
    },
    {
      "id": "personal-task-type",
      "label": "类型",
      "type": "select",
      "propertyName": "类型",
      "defaultValue": ["开发"],
      "multiple": true,
      "required": true,
      "options": [
        { "id": "personal-task-type-dev", "label": "开发", "value": "开发" },
        { "id": "personal-task-type-meeting", "label": "会议", "value": "会议" }
      ]
    },
    {
      "id": "personal-task-status",
      "label": "状态",
      "type": "select",
      "propertyName": "状态",
      "defaultValue": "待办",
      "required": true,
      "options": [
        { "id": "personal-task-status-todo", "label": "待办", "value": "待办" },
        { "id": "personal-task-status-doing", "label": "进行", "value": "进行" },
        { "id": "personal-task-status-done", "label": "完成", "value": "完成" }
      ]
    },
    {
      "id": "personal-task-deadline",
      "label": "截止时间",
      "type": "datetime",
      "defaultValueType": "custom",
      "defaultValue": "",
      "required": true
    }
  ],
  "actions": [
    {
      "type": "createFile",
      "targetFolder": "",
      "fileName": "",
      "id": "f3afa5b9-3ee7-4020-b45d-0b0e035ee998",
      "filePath": "个人/{{@项目}}/{{date:YYMMDD}}{{@任务}}.md",
      "conflictResolution": "skip",
      "contentTemplateSource": "text",
      "content": "---\n领域: 个人\n类型: [{{@类型}}]\n项目:\n  - \"[[{{@项目}}]]\"\n任务:\n  - \"[[{{date:YYMMDD}}{{@任务}}]]\"\n相关任务:\n状态: {{@状态}}\n创建时间: {{date:YYYY-MM-DDTHH:mm:ss}}\n截止时间: {{@截止时间}}:00\n完成时间:\n---\n\n## 待办列表\n- [ ] 编码\n- [ ] 测试\n- [ ] 合并"
    }
  ],
  "autoSubmit": false
}
