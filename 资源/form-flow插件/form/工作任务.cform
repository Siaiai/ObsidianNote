{
  "id": "98b6ec80-66a9-4f36-bb3f-48bfe3ce58fc",
  "fields": [
    {
      "id": "work-task-name",
      "label": "任务",
      "type": "text",
      "required": true,
      "defaultValue": [],
      "enableDescription": true,
      "description": "要做什么？一句话说清楚（会作为文件名的一部分）"
    },
    {
      "id": "work-task-project",
      "label": "项目",
      "type": "property_value_suggestion",
      "propertyName": "项目",
      "required": true
    },
    {
      "id": "work-task-type",
      "label": "类型",
      "type": "select",
      "propertyName": "类型",
      "defaultValue": ["开发"],
      "multiple": true,
      "required": true,
      "options": [
        { "id": "work-task-type-dev", "label": "开发", "value": "开发" },
        { "id": "work-task-type-meeting", "label": "会议", "value": "会议" },
        { "id": "work-task-type-plan", "label": "方案", "value": "方案" },
        { "id": "work-task-type-research", "label": "调研", "value": "调研" },
        { "id": "work-task-type-doc", "label": "文档", "value": "文档" }
      ]
    },
    {
      "id": "work-task-status",
      "label": "状态",
      "type": "select",
      "propertyName": "状态",
      "defaultValue": "待办",
      "required": true,
      "options": [
        { "id": "work-task-status-todo", "label": "待办", "value": "待办" },
        { "id": "work-task-status-doing", "label": "进行", "value": "进行" },
        { "id": "work-task-status-done", "label": "完成", "value": "完成" }
      ]
    },
    {
      "id": "work-task-deadline",
      "label": "截止时间",
      "type": "datetime",
      "defaultValueType": "custom",
      "defaultValue": "",
      "required": true
    }
  ],
  "actions": [
    {
      "type": "createFile",
      "targetFolder": "",
      "fileName": "",
      "id": "3e52a05b-778a-4b54-a225-5c9750dea1ee",
      "filePath": "工作/{{@项目}}/{{date:YYMMDD}}{{@任务}}.md",
      "conflictResolution": "skip",
      "contentTemplateSource": "text",
      "content": "---\n领域:\n  - 工作\n类型: [{{@类型}}]\n项目:\n  - \"[[{{@项目}}]]\"\n任务:\n  - \"[[{{date:YYMMDD}}{{@任务}}]]\"\n相关任务:\n状态: {{@状态}}\n创建时间: {{date:YYYY-MM-DDTHH:mm:ss}}\n截止时间: {{@截止时间}}:00\n完成时间:\n---\n\n## 待办列表\n- [ ] 编码\n- [ ] 测试\n- [ ] 合并"
    }
  ],
  "autoSubmit": false
}
