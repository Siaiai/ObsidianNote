{
  "id": "4395f1cf-3ed3-45cf-886c-0580dbb74667",
  "fields": [
    {
      "id": "personal-note-name",
      "label": "笔记名称",
      "type": "text",
      "required": true,
      "defaultValue": [],
      "enableDescription": true,
      "description": "记什么？（会作为文件名）"
    },
    {
      "id": "personal-note-project",
      "label": "项目",
      "type": "property_value_suggestion",
      "propertyName": "项目",
      "required": true
    },
    {
      "id": "personal-note-type",
      "label": "类型",
      "type": "select",
      "propertyName": "类型",
      "defaultValue": ["记录"],
      "multiple": true,
      "required": true,
      "options": [
        { "id": "personal-note-type-record", "label": "记录", "value": "记录" },
        { "id": "personal-note-type-goal", "label": "目标", "value": "目标" },
        { "id": "personal-note-type-habit", "label": "习惯", "value": "习惯" }
      ]
    },
    {
      "id": "personal-note-status",
      "label": "状态",
      "type": "select",
      "propertyName": "状态",
      "defaultValue": "规划中",
      "required": true,
      "options": [
        { "id": "personal-note-status-planning", "label": "规划中", "value": "规划中" },
        { "id": "personal-note-status-doing", "label": "进行中", "value": "进行中" },
        { "id": "personal-note-status-archived", "label": "已归档", "value": "已归档" }
      ]
    }
  ],
  "actions": [
    {
      "type": "createFile",
      "targetFolder": "",
      "fileName": "",
      "id": "9b731b07-d386-4562-a51b-1a338e1c161b",
      "filePath": "个人/{{@项目}}/{{@笔记名称}}.md",
      "conflictResolution": "skip",
      "contentTemplateSource": "text",
      "content": "---\n领域: 个人\n类型: [{{@类型}}]\n项目:\n  - \"[[{{@项目}}]]\"\n状态: {{@状态}}\n创建时间: {{date:YYYY-MM-DDTHH:mm:ss}}\n完成时间:\n---\n\n# {{@笔记名称}}\n\n"
    }
  ],
  "autoSubmit": false
}
