{
  "id": "3fae4e6b-c775-4339-9581-9ffd9724b154",
  "fields": [
    {
      "id": "study-note-name",
      "label": "笔记名称",
      "type": "text",
      "required": true,
      "defaultValue": [],
      "enableDescription": true,
      "description": "学什么？（会作为文件名）"
    },
    {
      "id": "study-note-project",
      "label": "项目",
      "type": "property_value_suggestion",
      "propertyName": "项目",
      "required": true
    },
    {
      "id": "study-note-type",
      "label": "类型",
      "type": "select",
      "propertyName": "类型",
      "defaultValue": ["笔记"],
      "multiple": true,
      "required": true,
      "options": [
        { "id": "study-note-type-note", "label": "笔记", "value": "笔记" },
        { "id": "study-note-type-practice", "label": "练习", "value": "练习" },
        { "id": "study-note-type-reading", "label": "阅读", "value": "阅读" },
        { "id": "study-note-type-course", "label": "课程", "value": "课程" }
      ]
    },
    {
      "id": "study-note-status",
      "label": "状态",
      "type": "select",
      "propertyName": "状态",
      "defaultValue": "待学",
      "required": true,
      "options": [
        { "id": "study-note-status-todo", "label": "待学", "value": "待学" },
        { "id": "study-note-status-doing", "label": "进行", "value": "进行" },
        { "id": "study-note-status-mastered", "label": "已掌握", "value": "已掌握" }
      ]
    }
  ],
  "actions": [
    {
      "type": "createFile",
      "targetFolder": "",
      "fileName": "",
      "id": "7f776940-c0c7-4883-b4ad-8850876e4a36",
      "filePath": "学习/{{@项目}}/{{@笔记名称}}.md",
      "conflictResolution": "skip",
      "contentTemplateSource": "text",
      "content": "---\n领域: 学习\n类型: [{{@类型}}]\n项目:\n  - \"[[{{@项目}}]]\"\n状态: {{@状态}}\n创建时间: {{date:YYYY-MM-DDTHH:mm:ss}}\n完成时间:\n---\n\n# {{@笔记名称}}\n\n"
    }
  ],
  "autoSubmit": false
}
